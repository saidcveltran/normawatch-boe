{
  "name": "normawatch-boe",
  "version": "1.8.0",
  "description": "Las nuevas disposiciones generales del BOE y, si quieres, las oposiciones y los boletines de Andalucía, Galicia y Cataluña, cada día en JSON y en tabla, con aviso opcional por correo, Telegram o Slack. Solo metadatos y enlaces oficiales. Gratis.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm run test",
    "start": "node src/main.ts",
    "deps:check": "node scripts/supply-chain-check.mjs"
  },
  "dependencies": {
    "apify": "3.7.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "apify-cli": "1.10.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.28",
    "browserslist": "4.29.3",
    "caniuse-lite": "1.0.30001815",
    "electron-to-chromium": "1.5.452",
    "generative-bayesian-network": "2.1.88",
    "header-generator": "2.1.88",
    "node-releases": "2.0.58",
    "strtok3": "10.4.1",
    "get-uri": {
      "basic-ftp": "6.2.3"
    }
  }
}
